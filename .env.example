# Google Apps Script Web App URL for email subscriptions
# See README for setup instructions
Subscribers=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Stripe secret key (server-side only — never expose to the client).
# Used by /api/create-checkout-session to create Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_...

# Optional. Absolute origin used to build success_url / cancel_url. If
# unset, the API derives the origin from the request headers, which works
# on Vercel and locally without extra config. Set this when running behind
# a proxy where the incoming Host header doesn't reflect the public URL.
# NEXT_PUBLIC_SITE_URL=https://peakstate.shop
